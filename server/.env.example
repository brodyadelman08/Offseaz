PORT=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required in production. Comma-separated list of allowed origins for CORS.
# If unset in production the server falls back to https://offseaz.com and
# https://www.offseaz.com (never to a wildcard) — but this variable should
# always be set explicitly on Railway so that fallback is never relied on.
# Example production value:
CORS_ORIGIN=https://offseaz.com,https://www.offseaz.com
