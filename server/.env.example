PORT=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Minimum age (in whole years) required to create an Offseaz account —
# enforced server-side in server/src/config/ageGate.js via POST
# /api/auth/check-age and re-checked in POST /api/auth/register. Defaults to
# 13 (COPPA) if unset. Change this single value (and redeploy) to move the
# cutoff, e.g. to 14 — no code changes needed. Note: the Terms of Service
# and Privacy Policy (client/src/pages/Legal.jsx) state this number in
# plain text and must be updated by hand to match if this is ever changed.
MIN_SIGNUP_AGE=13

# Required in production. Comma-separated list of allowed origins for CORS.
# If unset in production the server falls back to https://offseaz.com and
# https://www.offseaz.com (never to a wildcard) — but this variable should
# always be set explicitly on Railway so that fallback is never relied on.
# Example production value:
CORS_ORIGIN=https://offseaz.com,https://www.offseaz.com
